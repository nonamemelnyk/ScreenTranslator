# Environment variables for ScreenTranslator

# Translation settings
TRANSLATION_SERVICE=google  # Options: google, gpt, deepl
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=es

# API Keys for translation services
# At least one is required depending on your TRANSLATION_SERVICE
OPENAI_API_KEY=your_openai_api_key_here  # Required for GPT
DEEPL_AUTH_KEY=your_deepl_auth_key_here  # Required for DeepL

# Screenshot settings
SCREENSHOT_PROVIDER=pyautogui  # Options: pyautogui, pil

# Text recognition settings
TEXT_RECOGNITION_PROVIDER=tesseract  # Options: tesseract, mock
TESSERACT_CMD=path_to_tesseract_executable  # Required for Tesseract OCR on Windows

# Text insertion settings
TEXT_INSERTION_PROVIDER=pil  # Options: pil
INSERT_TRANSLATED_TEXT=True  # Whether to insert translated text into screenshots

# Debug settings
DEBUG_MODE=False
LOG_LEVEL=INFO
